# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Never commit .env.local.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Seeder PINs (4–6 digits), used by npm run db:seed. Only the bcrypt hash is stored.
SEED_PIN_ANGELIE=
